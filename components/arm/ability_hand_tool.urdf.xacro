<?xml version="1.0"?>
<!-- Ability Hand end effector (arm_tool:=ability_hand, the real robot since 2026-11-04): the PSYONIC Ability Hand
     (right, large) coaxial on the UR flange, the 3D-printed wrist collar (steve_grasping hardware/hand_camera_mount)
     and the RealSense D415 on the collar's arm BESIDE THE PALM. Simple shapes only (RViz / MoveIt / collision), so
     this package does not need steve_grasping's meshes. The WBC uses its own MuJoCo model of the same tool
     (steve_grasping config/tools/ability_hand.yaml): keep the numbers below in step with that file's mount, pinch
     and camera sections. The camera's optical frames come from steve_wbc gripper_camera.launch.py (mount:=ability_hand:
     its calibration, else the same nominal pose as here) — this file only places the housing.

     Frames:  <parent> (= ur5etool0, z out of the flange)
                -> ability_hand_collar (collar, its camera arm and electronics tray)
                -> ability_hand_base (wrist flange face of the hand; turned 180 deg about the flange axis:
                   palm towards -y of tool0, fingers along z)
                     -> ability_hand_palm (palm + straight fingers + thumb, the open hand)
                     -> ability_hand_pinch: the WBC's grasp point (object centre of the palm-down wrap)
                -> ability_hand_d415 (camera housing, nominal pose) -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="steve_ability_hand_tool" params="parent">

    <material name="ability_hand_black">
      <color rgba="0.10 0.10 0.10 1"/>
    </material>
    <material name="ability_hand_grey">
      <color rgba="0.35 0.35 0.37 1"/>
    </material>
    <material name="ability_hand_silver">
      <color rgba="0.82 0.82 0.84 1"/>
    </material>

    <xacro:macro name="ah_box" params="xyz size material">
      <visual>
        <origin xyz="${xyz}" rpy="0 0 0"/>
        <geometry><box size="${size}"/></geometry>
        <material name="${material}"/>
      </visual>
      <collision>
        <origin xyz="${xyz}" rpy="0 0 0"/>
        <geometry><box size="${size}"/></geometry>
      </collision>
    </xacro:macro>

    <!-- collar around wrist 3 (ability_hand.yaml camera.bracket, boxes in tool0): camera arm, electronics tray -->
    <joint name="ability_hand_collar_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="ability_hand_collar"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <link name="ability_hand_collar">
      <xacro:ah_box xyz="0 -0.0585 0.0025" size="0.040 0.033 0.035" material="ability_hand_black"/>
      <xacro:ah_box xyz="0 -0.0850 0.0200" size="0.050 0.020 0.030" material="ability_hand_black"/>
      <xacro:ah_box xyz="0 0.0545 0.0225" size="0.074 0.009 0.071" material="ability_hand_black"/>
      <xacro:ah_box xyz="0 0.0615 0.0250" size="0.074 0.014 0.046" material="ability_hand_grey"/>
      <inertial>
        <origin xyz="0 0 0.01" rpy="0 0 0"/>
        <mass value="0.12"/>
        <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
      </inertial>
    </link>

    <!-- hand base: straight on the flange, turned 180 deg about it (ability_hand.yaml mount) -->
    <joint name="ability_hand_base_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="ability_hand_base"/>
      <origin xyz="0 0 0" rpy="0 0 ${pi}"/>
    </joint>
    <link name="ability_hand_base">
      <visual>
        <origin xyz="0 0 0.015" rpy="0 0 0"/>
        <geometry><cylinder radius="0.024" length="0.030"/></geometry>
        <material name="ability_hand_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.015" rpy="0 0 0"/>
        <geometry><cylinder radius="0.024" length="0.030"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.015" rpy="0 0 0"/>
        <mass value="0.05"/>
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
      </inertial>
    </link>

    <!-- the open hand in the hand base frame (palm faces +y, fingers along +z, index at -x, pinky at +x) -->
    <joint name="ability_hand_palm_joint" type="fixed">
      <parent link="ability_hand_base"/>
      <child link="ability_hand_palm"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <link name="ability_hand_palm">
      <xacro:ah_box xyz="-0.008 0.0 0.065" size="0.085 0.040 0.075" material="ability_hand_black"/>
      <xacro:ah_box xyz="-0.008 0.0 0.148" size="0.080 0.020 0.095" material="ability_hand_grey"/>
      <xacro:ah_box xyz="-0.045 0.025 0.075" size="0.020 0.025 0.060" material="ability_hand_grey"/>
      <inertial>
        <origin xyz="-0.008 0 0.08" rpy="0 0 0"/>
        <mass value="0.45"/>
        <inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="4e-4"/>
      </inertial>
    </link>

    <!-- the WBC's grasp point (ability_hand.yaml pinch, in the hand base frame): z = approach, y = closing -->
    <joint name="ability_hand_pinch_joint" type="fixed">
      <parent link="ability_hand_base"/>
      <child link="ability_hand_pinch"/>
      <origin xyz="-0.010 0.055 0.110" rpy="${radians(-55)} 0 0"/>
    </joint>
    <link name="ability_hand_pinch"/>

    <!-- D415 housing at the collar's nominal camera pose (ability_hand.yaml camera: colour optical frame in tool0,
         housing offset in that frame). Not an optical frame: those come from gripper_camera.launch.py -->
    <joint name="ability_hand_d415_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="ability_hand_d415"/>
      <origin xyz="0.0325 -0.1064 0.0457" rpy="${radians(-40)} 0 ${pi}"/>
    </joint>
    <link name="ability_hand_d415">
      <visual>
        <origin xyz="0.0325 0 -0.010" rpy="0 0 0"/>
        <geometry><box size="0.099 0.023 0.020"/></geometry>
        <material name="ability_hand_silver"/>
      </visual>
      <collision>
        <origin xyz="0.0325 0 -0.010" rpy="0 0 0"/>
        <geometry><box size="0.099 0.023 0.020"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0.0325 0 -0.010" rpy="0 0 0"/>
        <mass value="0.072"/>
        <inertia ixx="4e-6" ixy="0" ixz="0" iyy="6e-5" iyz="0" izz="6e-5"/>
      </inertial>
    </link>

  </xacro:macro>
</robot>
