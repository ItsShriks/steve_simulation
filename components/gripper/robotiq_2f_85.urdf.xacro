<?xml version="1.0"?>
<!--
  Robotiq 2F-85 on the UR5e flange of Steve (MMO-700 + UR5e).

  Link/joint geometry adapted from PickNikRobotics/ros2_robotiq_gripper (humble,
  robotiq_description/urdf/robotiq_2f_85_macro.urdf.xacro, BSD-3-Clause); meshes are
  used from the installed robotiq_description package. Kept local so that the
  robot does not depend on the macro signature of a particular robotiq_description
  release. Mounting (UR-to-Robotiq adapter, 11 mm) as on the real robot.

  gripper_hw:
    gazebo          gazebo_ros2_control/GazeboSystem (mimic joints driven by the plugin)
    mock            mock_components/GenericSystem
    robotiq_driver  robotiq_driver/RobotiqGripperHardwareInterface (RS-485, e.g. UR tool port /tmp/ttyUR)
    none            no ros2_control block (description / TF only)

  Frames: gripper_tcp = between the fingertips (use as MoveIt end-effector tip).
  Command joint: robotiq_85_left_knuckle_joint, 0.0 = open ... 0.8 = closed.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="steve_robotiq_2f_85" params="parent gripper_hw:=none com_port:=/tmp/ttyUR">

        <!-- UR flange (tool0) -> adapter plate -> gripper -->
        <joint name="ur_to_robotiq_joint" type="fixed">
            <parent link="${parent}" />
            <child link="ur_to_robotiq_link" />
            <origin xyz="0 0 0" rpy="0 0 1.5707963267948966" />
        </joint>
        <link name="ur_to_robotiq_link">
            <visual>
                <geometry>
                    <mesh filename="package://robotiq_description/meshes/visual/2f_85/ur_to_robotiq_adapter.dae" />
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://robotiq_description/meshes/collision/2f_85/ur_to_robotiq_adapter.stl" />
                </geometry>
            </collision>
            <inertial>
                <mass value="0.01" />
                <origin xyz="0 0 0" />
                <inertia ixx="0.000044" ixy="0.0" ixz="0.0" iyy="0.000027" iyz="0.0" izz="0.000027" />
            </inertial>
        </link>
        <joint name="gripper_side_joint" type="fixed">
            <parent link="ur_to_robotiq_link" />
            <child link="gripper_mount_link" />
            <origin xyz="0 0 0.011" rpy="0 0 0" />
        </joint>
        <link name="gripper_mount_link" />

        <link name="robotiq_85_base_link">
            <visual>
                <geometry>
                    <mesh filename="package://robotiq_description/meshes/visual/2f_85/robotiq_base.dae" />
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://robotiq_description/meshes/collision/2f_85/robotiq_base.stl" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0.0 2.274e-05 0.03232288" rpy="0 0 0" />
                <mass value="6.6320197e-01" />
                <inertia ixx="5.1617816e-04" iyy="5.8802208e-04" izz="3.9462776e-04" ixy="2.936e-8" ixz="0.0" iyz="-3.2296e-7" />
            </inertial>
        </link>

        <link name="robotiq_85_left_knuckle_link">
            <visual>
                <geometry>
                    <mesh filename="package://robotiq_description/meshes/visual/2f_85/left_knuckle.dae" />
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://robotiq_description/meshes/collision/2f_85/left_knuckle.stl" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0.01213197 0.0002 -0.00058647" rpy="0 0 0" />
                <mass value="1.384773208e-02" />
                <inertia ixx="3.5232e-7" iyy="2.31944e-6" izz="2.23136e-6" ixy="0.0" ixz="1.1744e-7" iyz="0" />
            </inertial>
        </link>

        <link name="robotiq_85_right_knuckle_link">
            <visual>
                <geometry>
                    <mesh filename="package://robotiq_description/meshes/visual/2f_85/right_knuckle.dae" />
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://robotiq_description/meshes/collision/2f_85/right_knuckle.stl" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="-0.01213197 0.0002 -0.00058647" rpy="0 0 0" />
                <mass value="1.384773208e-02" />
                <inertia ixx="3.5232e-7" iyy="2.31944e-6" izz="2.23136e-6" ixy="0.0" ixz="-1.1744e-7" iyz="0.0" />
            </inertial>
        </link>

        <link name="robotiq_85_left_finger_link">
            <visual>
                <geometry>
                    <mesh filename="package://robotiq_description/meshes/visual/2f_85/left_finger.dae" />
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://robotiq_description/meshes/collision/2f_85/left_finger.stl" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0.00346899 -0.00079447 0.01867121" rpy="0 0 0" />
                <mass value="4.260376752e-02" />
                <inertia ixx="1.385792000000000e-05" iyy="1.183208e-05" izz="5.19672e-06" ixy="0.0" ixz="-2.17264e-06" iyz="0.0" />
            </inertial>
        </link>

        <link name="robotiq_85_right_finger_link">
            <visual>
                <geometry>
                    <mesh filename="package://robotiq_description/meshes/visual/2f_85/right_finger.dae" />
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://robotiq_description/meshes/collision/2f_85/right_finger.stl" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="-0.00346899 -5.53e-06 0.01867121" rpy="0 0 0" />
                <mass value="4.260376752000000e-02" />
                <inertia ixx="1.385792e-05" iyy="1.183208e-05" izz="5.19672e-06" ixy="0.0" ixz="2.17264e-06" iyz="0.0" />
            </inertial>
        </link>

        <link name="robotiq_85_left_inner_knuckle_link">
            <visual>
                <geometry>
                    <mesh filename="package://robotiq_description/meshes/visual/2f_85/left_inner_knuckle.dae" />
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://robotiq_description/meshes/collision/2f_85/left_inner_knuckle.stl" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0.01897699 0.00015001 0.02247101" rpy="0 0 0" />
                <mass value="2.969376448e-02" />
                <inertia ixx="9.57136e-06" iyy="8.69056e-06" izz="8.19144e-06" ixy="0.0" ixz="-3.93424e-06" iyz="0.0" />
            </inertial>
        </link>

        <link name="robotiq_85_right_inner_knuckle_link">
            <visual>
                <geometry>
                    <mesh filename="package://robotiq_description/meshes/visual/2f_85/right_inner_knuckle.dae" />
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://robotiq_description/meshes/collision/2f_85/right_inner_knuckle.stl" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="-0.01926824 5.001e-05 0.02222178" rpy="0 0 0" />
                <mass value="2.969376448e-02" />
                <inertia ixx="9.42456e-06" iyy="8.69056e-06" izz="8.33824e-06" ixy="0.0" ixz="3.9636e-06" iyz="0.0" />
            </inertial>
        </link>

        <link name="robotiq_85_left_finger_tip_link">
            <visual>
                <geometry>
                    <mesh filename="package://robotiq_description/meshes/visual/2f_85/left_finger_tip.dae" />
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://robotiq_description/meshes/collision/2f_85/left_finger_tip.stl" />
                </geometry>
                <surface>
                    <friction>
                    <ode>
                        <mu1>100000.0</mu1>
                        <mu2>100000.0</mu2>
                    </ode>
                    </friction>
                    <contact>
                    <ode>
                        <kp>1e+5</kp>
                        <kd>1</kd>
                        <soft_cfm>0</soft_cfm>
                        <soft_erp>0.2</soft_erp>
                        <minDepth>0.002</minDepth>
                        <maxVel>0</maxVel>
                    </ode>
                    </contact>
                </surface>
            </collision>
            <inertial>
                <origin xyz="-0.01456706 -0.0008 0.01649701" rpy="0 0 0" />
                <mass value="4.268588744e-02" />
                <inertia ixx="1.048152e-05" iyy="1.197888e-05" izz="4.22784e-06" ixy="0.0" ixz="3.5232e-6" iyz="0.0" />
            </inertial>
        </link>

        <link name="robotiq_85_right_finger_tip_link">
            <visual>
                <geometry>
                    <mesh filename="package://robotiq_description/meshes/visual/2f_85/right_finger_tip.dae" />
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://robotiq_description/meshes/collision/2f_85/right_finger_tip.stl" />
                </geometry>
                <surface>
                    <friction>
                    <ode>
                        <mu1>100000.0</mu1>
                        <mu2>100000.0</mu2>
                    </ode>
                    </friction>
                    <contact>
                    <ode>
                        <kp>1e+5</kp>
                        <kd>1</kd>
                        <soft_cfm>0</soft_cfm>
                        <soft_erp>0.2</soft_erp>
                        <minDepth>0.002</minDepth>
                        <maxVel>0</maxVel>
                    </ode>
                    </contact>
                </surface>
            </collision>
            <inertial>
                <origin xyz="0.01456706 5e-05 0.01649701" rpy="0 0 0" />
                <mass value="4.268588744e-02" />
                <inertia ixx="1.048152e-05" iyy="1.197888e-05" izz="4.22784e-06" ixy="0.0" ixz="-3.5232e-06" iyz="0.0" />
            </inertial>
        </link>

        <joint name="robotiq_85_base_joint" type="fixed">
            <parent link="gripper_mount_link" />
            <child link="robotiq_85_base_link" />
            <origin xyz="0 0 0" rpy="0 0 -1.5707963267948966" />
        </joint>

        <joint name="robotiq_85_left_knuckle_joint" type="revolute">
            <parent link="robotiq_85_base_link" />
            <child link="robotiq_85_left_knuckle_link" />
            <axis xyz="0 -1 0" />
            <origin xyz="0.03060114 0.0 0.05490452" rpy="0 0 0" />
            <limit lower="0.0" upper="0.8" velocity="0.5" effort="50" />
        </joint>

        <joint name="robotiq_85_right_knuckle_joint" type="revolute">
            <parent link="robotiq_85_base_link" />
            <child link="robotiq_85_right_knuckle_link" />
            <axis xyz="0 -1 0" />
            <origin xyz="-0.03060114 0.0 0.05490452" rpy="0 0 0" />
            <limit lower="-0.8" upper="0.0" velocity="0.5" effort="50" />
            <mimic joint="robotiq_85_left_knuckle_joint" multiplier="-1" />
        </joint>

        <joint name="robotiq_85_left_finger_joint" type="fixed">
            <parent link="robotiq_85_left_knuckle_link" />
            <child link="robotiq_85_left_finger_link" />
            <origin xyz="0.03152616 0.0 -0.00376347" rpy="0 0 0" />
        </joint>

        <joint name="robotiq_85_right_finger_joint" type="fixed">
            <parent link="robotiq_85_right_knuckle_link" />
            <child link="robotiq_85_right_finger_link" />
            <origin xyz="-0.03152616 0.0 -0.00376347" rpy="0 0 0" />
        </joint>

        <joint name="robotiq_85_left_inner_knuckle_joint" type="revolute">
            <parent link="robotiq_85_base_link" />
            <child link="robotiq_85_left_inner_knuckle_link" />
            <axis xyz="0 -1 0" />
            <origin xyz="0.0127 0.0 0.06142" rpy="0 0 0" />
            <mimic joint="robotiq_85_left_knuckle_joint" />
            <limit lower="0.0" upper="0.8" velocity="0.5" effort="50" />
        </joint>

        <joint name="robotiq_85_right_inner_knuckle_joint" type="revolute">
            <parent link="robotiq_85_base_link" />
            <child link="robotiq_85_right_inner_knuckle_link" />
            <axis xyz="0 -1 0" />
            <origin xyz="-0.0127 0.0 0.06142" rpy="0 0 0" />
            <mimic joint="robotiq_85_left_knuckle_joint" multiplier="-1" />
            <limit lower="-0.8" upper="0.0" velocity="0.5" effort="50" />
        </joint>

        <joint name="robotiq_85_left_finger_tip_joint" type="revolute">
            <parent link="robotiq_85_left_finger_link" />
            <child link="robotiq_85_left_finger_tip_link" />
            <axis xyz="0 -1 0" />
            <origin xyz="0.00563134 0.0 0.04718515" rpy="0 0 0" />
            <mimic joint="robotiq_85_left_knuckle_joint" multiplier="-1" />
            <limit lower="-0.8" upper="0.0" velocity="0.5" effort="50" />
        </joint>

        <joint name="robotiq_85_right_finger_tip_joint" type="revolute">
            <parent link="robotiq_85_right_finger_link" />
            <child link="robotiq_85_right_finger_tip_link" />
            <axis xyz="0 -1 0" />
            <origin xyz="-0.00563134 0.0 0.04718515" rpy="0 0 0" />
            <mimic joint="robotiq_85_left_knuckle_joint" />
            <limit lower="0.0" upper="0.8" velocity="0.5" effort="50" />
        </joint>

        <!-- Tool centre point between the fingertips (closed) -->
        <joint name="gripper_tcp_joint" type="fixed">
            <parent link="robotiq_85_base_link" />
            <child link="gripper_tcp" />
            <origin xyz="0 0 0.145" rpy="0 0 0" />
        </joint>
        <link name="gripper_tcp" />

        <xacro:unless value="${gripper_hw == 'none'}">
            <ros2_control name="robotiq_gripper" type="system">
                <hardware>
                    <xacro:if value="${gripper_hw == 'gazebo'}">
                        <plugin>gazebo_ros2_control/GazeboSystem</plugin>
                    </xacro:if>
                    <xacro:if value="${gripper_hw == 'mock'}">
                        <plugin>mock_components/GenericSystem</plugin>
                        <param name="state_following_offset">0.0</param>
                    </xacro:if>
                    <xacro:if value="${gripper_hw == 'robotiq_driver'}">
                        <plugin>robotiq_driver/RobotiqGripperHardwareInterface</plugin>
                        <param name="use_dummy">false</param>
                        <param name="COM_port">${com_port}</param>
                        <param name="gripper_closed_position">0.7929</param>
                        <param name="gripper_speed_multiplier">1.0</param>
                        <param name="gripper_force_multiplier">0.5</param>
                        <param name="gripper_max_speed">0.150</param>
                        <param name="gripper_max_force">235.0</param>
                    </xacro:if>
                </hardware>
                <joint name="robotiq_85_left_knuckle_joint">
                    <command_interface name="position" />
                    <state_interface name="position">
                        <param name="initial_value">0.0</param>
                    </state_interface>
                    <state_interface name="velocity" />
                </joint>
                <!-- the real driver moves the linkage itself; simulation needs the mimic joints -->
                <xacro:unless value="${gripper_hw == 'robotiq_driver'}">
                <joint name="robotiq_85_right_knuckle_joint">
                    <param name="mimic">robotiq_85_left_knuckle_joint</param>
                    <param name="multiplier">-1</param>
                    <command_interface name="position"/>
                    <state_interface name="position"/>
                    <state_interface name="velocity"/>
                </joint>
                <joint name="robotiq_85_left_inner_knuckle_joint">
                    <param name="mimic">robotiq_85_left_knuckle_joint</param>
                    <param name="multiplier">1</param>
                    <command_interface name="position"/>
                    <state_interface name="position"/>
                    <state_interface name="velocity"/>
                </joint>
                <joint name="robotiq_85_right_inner_knuckle_joint">
                    <param name="mimic">robotiq_85_left_knuckle_joint</param>
                    <param name="multiplier">-1</param>
                    <command_interface name="position"/>
                    <state_interface name="position"/>
                    <state_interface name="velocity"/>
                </joint>
                <joint name="robotiq_85_left_finger_tip_joint">
                    <param name="mimic">robotiq_85_left_knuckle_joint</param>
                    <param name="multiplier">-1</param>
                    <command_interface name="position"/>
                    <state_interface name="position"/>
                    <state_interface name="velocity"/>
                </joint>
                <joint name="robotiq_85_right_finger_tip_joint">
                    <param name="mimic">robotiq_85_left_knuckle_joint</param>
                    <param name="multiplier">1</param>
                    <command_interface name="position"/>
                    <state_interface name="position"/>
                    <state_interface name="velocity"/>
                </joint>
                </xacro:unless>
            </ros2_control>
        </xacro:unless>
    </xacro:macro>
</robot>
